{{- /* chezmoi:modify-template */ -}}
{{- /* Preserve locally installed hooks and statusLine (including Orca-managed integration); never replace runtime configuration with a static snapshot. */ -}}
{{- $current := fromJson (default "{}" .chezmoi.stdin) -}}
{{- $defaults := fromJson `{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "tui": "fullscreen"
}` -}}
{{- $result := mergeOverwrite $defaults $current -}}
{{ $result | toPrettyJson }}

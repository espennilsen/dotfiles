{{- end -}}
{{- if not (hasKey (index $result.providers "ollama-cloud") "apiKey") -}}
{{- $result = setValueAtPath "providers.ollama-cloud.apiKey" (onepasswordRead "op://Personal/OLLAMA_API_KEY/notesPlain") $result -}}
{{- end -}}
